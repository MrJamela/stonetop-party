<section class="party-list">
	{{#each rows}}
	<div class="pc{{#if isLow}} is-low{{/if}}{{#if dead}} is-dead{{/if}}">
		{{#if emblem}}<img class="emblem" src="{{emblem}}" alt="">{{else}}<span class="emblem"></span>{{/if}}
		<div class="pc-body">
			<div class="name">{{name}}</div>
			<div class="line vitals-line">
				{{#if dead}}<span class="stonetop-dead-tag" data-tooltip="{{dead.hint}}" data-tooltip-direction="UP"><i class="fas fa-skull"></i><span class="stonetop-dead-tag-text">{{dead.word}}</span></span>{{/if}}
				<span class="vitals">
					<span class="armor"><span class="label">Armor</span>{{armor}}</span>
					<span class="hp"><span class="label">HP</span>{{hp}}<span class="max"> / {{hpMax}}</span></span>
				</span>
			</div>
			<div class="bar"><span style="width: {{hpPct}}%"></span></div>
			<div class="line">
				{{#if insert}}
				<span class="playbook">{{insert}} <s class="was">{{playbook}}</s></span>
				{{else}}
				<span class="playbook">{{playbook}}</span>
				{{/if}}
				<span class="load{{#if load.isOver}} is-over{{/if}}">
					<span class="word">{{load.word}}</span>
					{{#each load.pips}}<i class="pip{{#if this}} on{{/if}}"></i>{{/each}}
				</span>
			</div>
			{{#if hasHarm}}
			<div class="harm">
				{{#if debilities}}<div class="debilities">{{debilities}}</div>{{/if}}
				{{#each wounds}}<div class="wound">{{text}} <span class="status">({{status}})</span></div>{{/each}}
			</div>
			{{/if}}
		</div>
	</div>
	{{/each}}
	{{#if empty}}<p class="empty">No player characters yet.</p>{{/if}}
</section>
